__pycache__/
*.pyc
*.pyo
*.py[cod]
*$py.class

# Virtual environment
venv/
.venv/
env/

# Generated reports and outputs
outputs/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local env secrets
.env
.env.*

# Large ML weights (auto-downloaded on first use)
models/*.pt
models/*.onnx
!models/*.task
yolov8*.pt
yolo11*.pt
*.pt
!models/*.task

# Jupyter
.ipynb_checkpoints/

# Temporal model local artifacts. Weights, logs and feature arrays are
# rebuilt from the videos and the pipeline, so they are never committed --
# a checkpoint in git goes stale the moment a band or a phase cut changes,
# and nothing warns you that it has.
temporal/artifacts/**
temporal/checkpoints/**
temporal/tensorboard/**
temporal/data/*.npz
temporal/data/*.npy
!temporal/**/.gitkeep

mlRingBall/datasets
mlRingBall/datasets/runs/basketball_rim_training/basketball_and_rim/weights

# Local video assets
assets/videos/**/*.mp4
assets/videos/**/*.mov
assets/videos/**/*.avi
assets/videos/**/*.mkv
assets/videos/**/*.webm

# Generated TensorRT models
models/*.engine
# Python build artifacts
*.egg-info/
build/
dist/
