__pycache__/
*.pyc
*.pyo
*.py[cod]
*$py.class

# Virtual environment
venv/
.venv/
env/

# Generated reports and outputs
outputs/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local env secrets
.env
.env.*

# Large or generated ML weights. Keep the deployed runtime models below.
models/*.pt
models/*.onnx
yolov8*.pt
yolo11*.pt
*.pt

!models/best.pt
!models/*.task
!models/nanotrack/
!models/nanotrack/**

# Jupyter
.ipynb_checkpoints/

# Temporal model local artifacts. Weights, logs and feature arrays are
# rebuilt from the videos and the pipeline, so they are never committed --
# a checkpoint in git goes stale the moment a band or a phase cut changes,
# and nothing warns you that it has.
temporal/artifacts/**
temporal/checkpoints/**
temporal/tensorboard/**
temporal/data/*.npz
temporal/data/*.npy
!temporal/**/.gitkeep
ml/datasets/videos
mlRingBall/datasets
mlRingBall/datasets/runs/basketball_rim_training/basketball_and_rim/weights

mlRingBall/datasets

# Local video assets
/assets/Untitled.mov
assets/videos/**/*.mp4
assets/videos/**/*.mov
assets/videos/**/*.avi
assets/videos/**/*.mkv
assets/videos/**/*.webm

# Generated TensorRT models
models/*.engine
# Python build artifacts
*.egg-info/
build/
dist/

# Partial downloads. `yt-dlp` leaves a .part behind whenever a fetch is
# interrupted: not data, not playable, and useless to anyone else -- but eight
# of them reached the history and account for ~13 MB of what a clone pulls.
# Git keeps them forever, so untracking cannot shrink that; this only stops it
# growing.
*.part
temporal/data/staging/
